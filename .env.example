# Environment variables for Solvaxon: copy this file to .env in the project root (file mode 600; Git ignores .env) and give every variable a value. Astro reads .env when the site is built, and the server reads it at runtime through the Node.js option --env-file=.env. Everything after a # is a comment, so a value that contains # must be quoted.

# Address the server listens on: 127.0.0.1 in production, so that only programs on the same machine, such as the local proxy, can connect.
HOST=127.0.0.1

# Port the server listens on.
PORT=4321

# Site key of the Cloudflare Turnstile widget (public).
TURNSTILE_SITE_KEY=

# Secret key of the Cloudflare Turnstile widget (secret).
TURNSTILE_SECRET_KEY=

# Mailgun Domain Sending Key of the sending domain (secret).
MAILGUN_SENDING_KEY=

# Verified Mailgun sending domain (public).
MAILGUN_DOMAIN=mg.solvaxon.com

# Region of the Mailgun sending domain (public): us or eu.
MAILGUN_REGION=eu

# Private email address that receives contact form submissions (secret).
CONTACT_TO_ADDRESS=
