---
// Site header: on the page's ivory background, the dark Solvaxon wordmark as the link to the home page, and the site navigation with text links to the Services and About pages side by side, at the far end of the same line or, when the header is too narrow for both, on its own line below the wordmark.
import wordmark from "../assets/brand/solvaxon-wordmark-dark.svg";
import { aboutPage, servicesPage } from "../lib/site";
---

<header class="page-width site-header">
	<a href="/">
		<img
			class="wordmark"
			src={wordmark.src}
			width={wordmark.width}
			height={wordmark.height}
			alt="Solvaxon home"
		/>
	</a>
	<nav class="site-nav">
		<a href={servicesPage.path}>{servicesPage.name}</a>
		<a href={aboutPage.path}>{aboutPage.name}</a>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding-block: 1.25rem;
	}

	.wordmark {
		display: block;
		width: clamp(8.5rem, 7rem + 4vw, 11rem);
		height: auto;
	}

	.site-nav {
		display: flex;
		column-gap: 1.5rem;
	}
</style>
