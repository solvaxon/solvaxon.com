---
// Home page: the page title and description; the deep-green hero with its label, main heading, hairline rule, lead paragraph (the description text), and the ivory Solvaxon symbol as a decorative background; the section on what Solvaxon builds, with its heading and a numbered list with one row per service, each below a hairline rule: the service's number and its name, which links to the service's section on the Services page (the name and the link target come from site.ts), with a short summary below them, or beside them when the viewport is at least 48rem wide; below a hairline rule, the section on how Solvaxon works, with its heading and the four steps on the route line, a deep-green line with a square stop centred on it at each step, running down the side of the steps, or along the top of four columns when the viewport is at least 48rem wide; and, at the end of the page content, the structured data for search engines: a JSON-LD script element with WebSite data (the site name and the home page URL) and OnlineBusiness data (the same name and URL, the URL of the square Solvaxon logo, and the description text). OnlineBusiness is the subtype of Organization that Google recommends for a business that, like Solvaxon, works only online.
import BaseLayout from "../layouts/BaseLayout.astro";
import { services, servicesPage, siteName } from "../lib/site";

const description =
	"Solvaxon builds websites, web applications, custom online tools and other web-based projects that help individuals and businesses bring ideas to life and solve practical problems.";
const homeUrl = new URL("/", Astro.site).href;
const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: siteName,
		url: homeUrl,
	},
	{
		"@context": "https://schema.org",
		"@type": "OnlineBusiness",
		name: siteName,
		url: homeUrl,
		logo: new URL("/solvaxon-square.png", Astro.site).href,
		description,
	},
];
---

<BaseLayout
	title={`${siteName} - Websites, web applications and custom online tools`}
	description={description}
>
	<div class="hero">
		<div class="page-width hero-layout">
			<p class="label">Web development</p>
			<h1>
				Websites and web applications, built to{" "}
				<span class="accent">solve.</span>
			</h1>
			<p class="lead">{description}</p>
		</div>
	</div>
	<section class="page-width builds">
		<h2>What Solvaxon builds</h2>
		<ol class="build-list">
			<li>
				<header>
					<p class="number">01</p>
					<h3>
						<a href={`${servicesPage.path}#${services.websites.anchor}`}>
							{services.websites.name}
						</a>
					</h3>
				</header>
				<p>A home on the web for a person, a business or an idea.</p>
			</li>
			<li>
				<header>
					<p class="number">02</p>
					<h3>
						<a href={`${servicesPage.path}#${services.webApplications.anchor}`}>
							{services.webApplications.name}
						</a>
					</h3>
				</header>
				<p>
					Software that people use in a web browser to get work done, without
					installing anything.
				</p>
			</li>
			<li>
				<header>
					<p class="number">03</p>
					<h3>
						<a
							href={`${servicesPage.path}#${services.customOnlineTools.anchor}`}
						>
							{services.customOnlineTools.name}
						</a>
					</h3>
				</header>
				<p>
					A tool that does one specific job in the browser, built around the way
					you work.
				</p>
			</li>
			<li>
				<header>
					<p class="number">04</p>
					<h3>
						<a
							href={`${servicesPage.path}#${services.otherWebProjects.anchor}`}
						>
							{services.otherWebProjects.name}
						</a>
					</h3>
				</header>
				<p>
					Web-based projects that do not fit neatly into the categories above,
					for example a prototype that tests an idea before it is fully built.
				</p>
			</li>
		</ol>
	</section>
	<section class="page-width process">
		<h2>How Solvaxon works</h2>
		<ol class="route">
			<li>Understand the problem</li>
			<li>Structure the solution</li>
			<li>Build the product</li>
			<li>Deliver the finished product</li>
		</ol>
	</section>
	<script
		type="application/ld+json"
		set:html={JSON.stringify(structuredData)}
	/>
</BaseLayout>

<style>
	.hero {
		padding-block: clamp(3rem, 2rem + 5vw, 6rem);
		background-color: var(--color-deep-green);
		color: var(--color-ivory);
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 2.75rem;
		gap: 1.5rem;
		align-items: center;
	}

	.hero-layout::before {
		content: "";
		grid-column: 1 / -1;
		grid-row: 3;
		border-top: 1px solid var(--color-rule-dark);
	}

	.hero-layout::after {
		content: "";
		grid-column: 2;
		grid-row: 1;
		aspect-ratio: 1;
		background: url("/brand/solvaxon-symbol-light.svg") center / contain
			no-repeat;
	}

	.label {
		grid-column: 1;
		grid-row: 1;
		margin: 0;
		color: var(--color-sage);
		font-size: 0.8125rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		grid-column: 1 / -1;
		grid-row: 2;
		margin: 0;
		font-size: clamp(2.25rem, 1.25rem + 4.5vw, 4.75rem);
		font-weight: 400;
		line-height: 1.08;
	}

	.accent {
		color: var(--color-lime);
	}

	.lead {
		grid-column: 1 / -1;
		grid-row: 4;
		max-width: 60ch;
		margin: 0;
		font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.25rem);
	}

	.builds {
		padding-block-start: clamp(2.5rem, 1.5rem + 4vw, 5rem);
	}

	.build-list {
		margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.build-list li {
		display: grid;
		gap: 0.75rem;
		padding-block: clamp(1.25rem, 1rem + 1vw, 1.75rem);
		border-top: 1px solid var(--color-rule-light);
	}

	.build-list h3 {
		margin: 0;
		font-size: clamp(1.25rem, 1.125rem + 0.625vw, 1.5rem);
		font-weight: 400;
		line-height: 1.2;
	}

	.build-list li > p {
		max-width: 60ch;
		margin: 0;
	}

	.process {
		padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
		border-top: 1px solid var(--color-rule-light);
	}

	.route {
		--line-width: 1px;
		--stop-size: 9px;
		margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 0
			calc((var(--stop-size) - var(--line-width)) / 2);
		padding: 0;
		border-left: var(--line-width) solid var(--color-deep-green);
		list-style: none;
	}

	.route li {
		position: relative;
		padding-inline-start: 1.5rem;
		font-size: clamp(1.25rem, 1.125rem + 0.625vw, 1.5rem);
		line-height: 1.2;
	}

	.route li + li {
		margin-block-start: 1.5rem;
	}

	.route li::before {
		content: "";
		position: absolute;
		top: calc(0.6em - var(--stop-size) / 2);
		left: calc((var(--line-width) + var(--stop-size)) / -2);
		width: var(--stop-size);
		height: var(--stop-size);
		background-color: var(--color-deep-green);
	}

	@media (min-width: 48rem) {
		.build-list li {
			grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
			column-gap: 3rem;
		}

		.route {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			column-gap: 1.5rem;
			margin-inline-start: 0;
			border-top: var(--line-width) solid var(--color-deep-green);
			border-left: none;
		}

		.route li {
			padding-block-start: 1.5rem;
			padding-inline-start: 0;
		}

		.route li + li {
			margin-block-start: 0;
		}

		.route li::before {
			top: calc((var(--line-width) + var(--stop-size)) / -2);
			left: 0;
		}
	}

	@media (min-width: 64rem) {
		.hero-layout {
			grid-template-columns: minmax(0, 1fr) 18rem;
			gap: 2rem 4rem;
		}

		.hero-layout::after {
			grid-row: 1 / span 2;
		}

		h1 {
			grid-column: 1;
		}
	}
</style>
