---
// Home page: the page title and description, and the deep-green hero with its label, main heading, hairline rule, lead paragraph (the description text), and the ivory Solvaxon symbol as a decorative background.
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteName } from "../lib/site";

const description =
	"Solvaxon builds websites, web applications, custom online tools and other web-based projects that help individuals and businesses bring ideas to life and solve practical problems.";
---

<BaseLayout
	title={`${siteName} - Websites, web applications and custom online tools`}
	description={description}
>
	<div class="hero">
		<div class="page-width hero-layout">
			<p class="label">Web development</p>
			<h1>
				Websites and web applications, built to{" "}
				<span class="accent">solve.</span>
			</h1>
			<p class="lead">{description}</p>
		</div>
	</div>
</BaseLayout>

<style>
	.hero {
		padding-block: clamp(3rem, 2rem + 5vw, 6rem);
		background-color: var(--color-deep-green);
		color: var(--color-ivory);
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 2.75rem;
		gap: 1.5rem;
		align-items: center;
	}

	.hero-layout::before {
		content: "";
		grid-column: 1 / -1;
		grid-row: 3;
		border-top: 1px solid var(--color-rule-dark);
	}

	.hero-layout::after {
		content: "";
		grid-column: 2;
		grid-row: 1;
		aspect-ratio: 1;
		background: url("/brand/solvaxon-symbol-light.svg") center / contain
			no-repeat;
	}

	.label {
		grid-column: 1;
		grid-row: 1;
		margin: 0;
		color: var(--color-sage);
		font-size: 0.8125rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		grid-column: 1 / -1;
		grid-row: 2;
		margin: 0;
		font-size: clamp(2.25rem, 1.25rem + 4.5vw, 4.75rem);
		font-weight: 400;
		line-height: 1.08;
	}

	.accent {
		color: var(--color-lime);
	}

	.lead {
		grid-column: 1 / -1;
		grid-row: 4;
		max-width: 60ch;
		margin: 0;
		font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.25rem);
	}

	@media (min-width: 64rem) {
		.hero-layout {
			grid-template-columns: minmax(0, 1fr) 18rem;
			gap: 2rem 4rem;
		}

		.hero-layout::after {
			grid-row: 1 / span 2;
		}

		h1 {
			grid-column: 1;
		}
	}
</style>
